rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isTeacher() { 
      return isSignedIn() && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /assignments/{assignmentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }
    
    match /submissions/{submissionId} {
      allow read: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin() || isTeacher());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.studentId == request.auth.uid || isAdmin() || isTeacher());
    }

    match /classes/{classId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /evaluations/{evaluationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher();
    }

    match /appeals/{appealId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isTeacher() || (isSignedIn() && resource.data.studentId == request.auth.uid);
    }
    
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
